{
  "name": "memory-lane",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @memory-lane/core test",
    "test:cli": "pnpm --filter @memory-lane/cli test",
    "build:binary": "bun scripts/build-binaries.ts --current",
    "smoke:binary": "bun scripts/smoke-binary.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b"
}
